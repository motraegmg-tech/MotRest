{
  "name": "@motrest/relay",
  "version": "0.0.0",
  "private": true,
  "description": "Relay de mensajería en la nube: enruta WhatsApp entre Meta y el Hub de cada restaurante, sin ver la operación del local.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "empaquetar": "node construir.mjs",
    "padron": "tsx src/padron-cli.ts",
    "ensayo": "node ensayo/webhook.mjs"
  },
  "dependencies": {
    "@motrest/dominio": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
