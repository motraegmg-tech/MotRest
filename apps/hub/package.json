{
  "name": "@motrest/hub",
  "version": "0.0.0",
  "private": true,
  "description": "MotRest Hub — servicio de fondo del local: secuencia total del event log, sincronización LAN y soporte del modo isla.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "empaquetar": "node empaquetar.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@motrest/dominio": "workspace:*",
    "@motrest/protocolo-sync": "workspace:*",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@peculiar/x509": "1.14.3",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
