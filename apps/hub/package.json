{
  "name": "@motrest/hub",
  "version": "1.3.6",
  "private": true,
  "description": "MotRest Hub — servicio de fondo del local: secuencia total del event log, sincronización LAN y soporte del modo isla.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "empaquetar": "node empaquetar.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "ensayo": "tsx ensayo/viernes.ts",
    "ensayo:portal": "tsx ensayo/portal.ts",
    "ensayo:nube": "tsx ensayo/nube.ts",
    "ensayo:canal": "tsx ensayo/canal.ts"
  },
  "dependencies": {
    "@motrest/dominio": "workspace:*",
    "@motrest/protocolo-sync": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@peculiar/x509": "1.14.3",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
