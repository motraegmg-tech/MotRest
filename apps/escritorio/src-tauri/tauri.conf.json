{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MotRest",
  "version": "1.0.4",
  "identifier": "mx.motrae.motrest",
  "build": {
    "frontendDist": "../arranque"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MotRest — Punto de venta",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' http://localhost:8788 http://127.0.0.1:8788"
      },
      "capabilities": ["local"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "MOTRAE",
    "copyright": "MOTRAE",
    "category": "Business",
    "shortDescription": "Punto de venta y ERP restaurantero",
    "longDescription": "MotRest: punto de venta, cocina, inventario y administración para restaurantes. Incluye el Hub del local, que registra la operación y la comparte entre las terminales.",
    "externalBin": ["binarios/motrest-hub"],
    "resources": {
      "../../pos-ui/dist": "pos/",
      "../../portal/dist": "portal/"
    },
    "windows": {
      "nsis": {
        "languages": ["Spanish", "SpanishInternational"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./hooks.nsi"
      }
    }
  }
}
