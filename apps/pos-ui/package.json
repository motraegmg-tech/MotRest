{
  "name": "pos-ui",
  "version": "0.0.0",
  "private": true,
  "description": "MotRest POS — UI de caja (Svelte 5 + Vite). Pantalla P1: mesas, configurador mitad-y-mitad y cuenta, alimentada por @motrest/dominio.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "@motrest/dominio": "workspace:*",
    "@motrest/impresion": "workspace:*",
    "@motrest/protocolo-sync": "workspace:*",
    "@motrest/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
