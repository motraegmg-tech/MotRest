{
  "name": "pos-ui",
  "version": "0.0.0",
  "private": true,
  "description": "MotRest POS — UI de caja (Svelte 5 + Vite). Pantalla P1: mesas, configurador mitad-y-mitad y cuenta, alimentada por @motrest/dominio.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@motrest/dominio": "workspace:*",
    "@motrest/impresion": "workspace:*",
    "@motrest/protocolo-sync": "workspace:*",
    "@motrest/ui": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
