# Registro explícito.
#
# Sin esta línea, el registro es el que tenga configurado la máquina que
# instale — y una máquina con un registro interno mal apuntado resolvería
# `@motrest/dominio` contra él en vez de contra el workspace.
#
# Hoy el riesgo real es bajo: los siete paquetes internos se declaran como
# `workspace:*`, protocolo que pnpm resuelve ESTRICTAMENTE dentro del monorepo
# y que FALLA si no encuentra el paquete, en vez de caer al registro público.
# Esto cierra el caso del día que alguien cambie un `workspace:*` por un rango.
registry=https://registry.npmjs.org/

# Nunca resolver versiones distintas de las auditadas.
#
# Un `pnpm install` sin esto puede traer versiones que nadie revisó, en la
# misma máquina que después firma el instalador de todos los restaurantes.
frozen-lockfile=true
